---
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1 class="hero-title">
        Turn Visitors Into <span class="hero-highlight">Customers</span>
      </h1>
      <p class="hero-subtitle">
        A high-performance landing page built for speed, conversions, and precise
        analytics tracking. No bloat. No compromise.
      </p>
      <button class="cta-btn" data-cta-id="hero_get_started">
        Get Started
      </button>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.cta-btn').forEach(button => {
    button.addEventListener('click', (e) => {
      const ctaId = e.currentTarget.getAttribute('data-cta-id') || 'unlabeled_cta';
      window.pushDataLayer?.('button_click', {
        cta_id: ctaId,
        click_text: e.currentTarget.innerText.trim()
      });
    });
  });
</script>

<style is:global>
  .hero {
    padding: var(--space-xl) 0 var(--space-lg);
    text-align: center;
    background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 50%, #dbeafe 100%);
  }

  .hero-content {
    max-width: 720px;
    margin: 0 auto;
  }

  .hero-title {
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-highlight {
    color: var(--color-primary);
  }

  .hero-subtitle {
    margin-top: var(--space-sm);
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .cta-btn {
    display: inline-block;
    margin-top: var(--space-md);
    padding: 1rem 2.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: #fff;
    background: var(--color-primary);
    border: none;
    border-radius: var(--radius);
    cursor: pointer;
    transition: background 0.2s ease, transform 0.15s ease;
  }

  .cta-btn:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
  }

  .cta-btn:active {
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .hero {
      padding: var(--space-lg) 0 var(--space-md);
    }

    .cta-btn {
      width: 100%;
      max-width: 400px;
    }
  }
</style>
